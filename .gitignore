# Client order data must NEVER be committed. Blanket-ignore the formats an
# extract arrives in, so a stray orders.csv cannot be added by accident.
*.csv
*.xlsx
*.xls
*.xlsm

# Generated output - regenerate with --sample or a real run
output/
output_*/

__pycache__/
*.pyc

# TCA reviews hold client screenshots, transcribed numbers and client-facing
# decks. None of it belongs in the repo.
reviews/
*.heic
*.HEIC
*.pptx
